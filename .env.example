# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-26

# Google Places API (optional - for venue city lookup)
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Postmark Email (for newsletter/notifications)
# Use the Server Token from: Postmark Dashboard → Servers → [Server] → API Tokens → "Server API tokens" tab
# NOT the Account API Key — that is a different credential
POSTMARK_SERVER_TOKEN=your_postmark_server_token

# Supabase (for email subscriptions)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Base URL (used by cron job to self-call /api/email)
URL=https://yourdomain.com
